flight.guilleme.net {
	encode zstd gzip

	handle_path /api/route/* {
		rewrite * /v0/callsign{path}
		reverse_proxy https://api.adsbdb.com {
			header_up Host api.adsbdb.com
			header_up User-Agent "AeroScope/1.0"
		}
	}

	handle_path /api/aircraft/* {
		rewrite * /v2{path}
		reverse_proxy https://api.adsb.lol {
			header_up Host api.adsb.lol
			header_up User-Agent "AeroScope/1.0"
		}
	}

	handle /api/opensky {
		rewrite * /api/states/all
		reverse_proxy https://opensky-network.org {
			header_up Host opensky-network.org
			header_up User-Agent "AeroScope/1.0"
		}
	}

	handle /api/geocode {
		rewrite * /search
		reverse_proxy https://nominatim.openstreetmap.org {
			header_up Host nominatim.openstreetmap.org
			header_up User-Agent "AeroScope/1.0"
		}
	}

	handle {
		root * /opt/flight.guilleme.net
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /models/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
