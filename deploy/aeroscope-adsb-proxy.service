[Unit]
Description=AeroScope ADS-B proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/flight-proxy/adsb-proxy.mjs
Restart=on-failure
RestartSec=2
User=nobody
Group=nobody
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
